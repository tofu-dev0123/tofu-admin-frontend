{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm type)",
      "Bash(pnpm test)",
      "Bash(pnpm exec vitest run)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec prettier --check .)",
      "Bash(nix develop --command pnpm install)",
      "Bash(nix develop --command pnpm lint)",
      "Bash(nix develop --command pnpm type)",
      "Bash(nix develop --command pnpm test)",
      "Bash(scripts/check.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(git status)",
      "Bash(git status --porcelain)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff HEAD)",
      "Bash(git diff develop...HEAD)",
      "Bash(git diff --stat develop...HEAD)",
      "Bash(git log)",
      "Bash(git log --oneline -10)",
      "Bash(git log --oneline develop..HEAD)",
      "Bash(git show --stat HEAD)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git remote -v)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch --prune)",
      "Bash(git checkout develop)",
      "Bash(git pull origin develop)",
      "Bash(git stash list)",
      "Bash(git stash show)",
      "Bash(ls)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.*.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path // empty'); base=$(basename \"$fp\"); case \"$base\" in .env.example|.env.local|.envrc) exit 0 ;; .env|.env.*) echo \"Writes to $base are blocked. Allowed: .env.example, .env.local\" >&2; exit 2 ;; esac; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-check.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -z \"$f\" ] && exit 0; d=\"${CLAUDE_PROJECT_DIR:-.}\"; cd \"$d\" || exit 0; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.mjs|*.json|*.css|*.md) direnv exec \"$d\" ./node_modules/.bin/prettier --write \"$f\" >/dev/null 2>&1 ;; esac; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.mjs) direnv exec \"$d\" ./node_modules/.bin/eslint --fix \"$f\" >/dev/null 2>&1 ;; esac; exit 0; }"
          }
        ]
      }
    ]
  }
}
